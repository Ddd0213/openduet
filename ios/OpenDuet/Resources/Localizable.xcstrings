    "agent.welcome" : {
      "comment" : "Server-built text (backend/src/i18n phrases). The app fills {name} placeholders from Phrase.params.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi {name}, welcome! Today's our first day working together. I'm going to help you stay on top of your work and life. Every day I'll get to know you a little better. Over time, I'll start spotting what you need before you even ask."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好，{name}，欢迎！今天是我们一起工作的第一天。我会帮你把工作和生活安排得井井有条。我每天都会多了解你一点，慢慢地，你还没开口，我就能想到你需要什么。"
          }
        }
      }
    },
    "agent.welcome_scan" : {
      "comment" : "Server-built text (backend/src/i18n phrases). The app fills {name} placeholders from Phrase.params.",
