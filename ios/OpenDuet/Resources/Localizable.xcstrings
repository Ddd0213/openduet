      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm going to check your apps to determine who you are and how I can help. Be right back!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我先去看看你的 App，了解你是谁、我能怎么帮你。马上回来！"
