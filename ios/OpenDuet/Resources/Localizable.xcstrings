    "A key for one web API. OpenDuet can call that domain with it and nothing else." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个网络 API 的密钥。OpenDuet 只能用它访问这个域名，别处都不行。"
          }
        }
      }
    },
    "A new address needs the key again: the saved one is never sent to a different address." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换了地址要重新填密钥：已保存的密钥不会发往别的地址。"
          }
        }
      }
    },
    "A new address, header or key is checked before it's saved. A saved secret left blank stays as it is." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的地址、请求头或密钥会先检查连接再保存。已保存的密钥留空就保持不变。"
          }
        }
      }
    },
    "A number of tokens, like 200000." : {
      "localizations" : {
        "zh-Hans" : {
