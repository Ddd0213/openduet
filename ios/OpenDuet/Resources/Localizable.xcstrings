    "Delete \"%@\"? It leaves your gallery. This can't be undone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除「%@」？它会从你的创作中移除，且无法撤销。"
          }
        }
      }
    },
    "Delete \"%@\"? It's removed from your files. This can't be undone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除「%@」？它会从你的文件中移除，且无法撤销。"
          }
        }
      }
    },
    "Delete #%@? Deletes its messages, tasks and files. Creations move to your main chat." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 #%@？其中的消息、任务和文件都会删除，创作会移到你的主聊天。"
          }
        }
      }
    },
    "Delete %@? Channels that use it go back to the default model." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %@？用它的频道会改回默认模型。"
          }
        }
      }
    },
    "Delete %@? Its key and its models are removed. Channels that used them go back to the default model." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %@？它的密钥和模型都会被移除，用过这些模型的频道会改回默认模型。"
          }
        }
      }
    },
    "Delete %@? Its saved secrets are removed and OpenDuet can't use it anywhere." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除“%@”？保存的密钥会一并删除，OpenDuet 在哪里都用不了它了。"
