diff -ruN a/tests/followed-page.test.ts b/tests/followed-page.test.ts
--- a/tests/followed-page.test.ts	1970-01-01 08:00:00
+++ b/tests/followed-page.test.ts	2026-10-28 00:00:00
@@ -0,0 +1,67 @@
+// OpenDuet patch 0004: in window mode the Bot follows the tab the person has in front.
+import { describe, expect, test } from "bun:test";
+import { chooseFollowedPage, confirmShown, pickShownPage } from "../src/live-page";
+
+const page = (name: string, closed = false) => ({ name, isClosed: () => closed });
+
+describe("the page followed in window mode", () => {
+  test("a page that just opened takes over", () => {
+    const a = page("a"), b = page("b");
+    expect(chooseFollowedPage([a, b], a, b)).toBe(b);
+  });
+
+  test("otherwise the page followed until now stays, even when it is not the newest", () => {
+    const a = page("a"), b = page("b"), c = page("c");
+    expect(chooseFollowedPage([a, b, c], a)).toBe(a);
+  });
+
+  test("when it closes, the newest open page", () => {
+    const a = page("a", true), b = page("b"), c = page("c");
+    expect(chooseFollowedPage([a, b, c], a)).toBe(c);
+    expect(chooseFollowedPage([b, c], a)).toBe(c);
+  });
+});
+
+describe("the tab in front, from Chromium's window name", () => {
+  const a = page("a"), b = page("b"), c = page("c");
+  const pages = [
+    { page: a, title: "Tab A", url: "https://a.example/" },
+    { page: b, title: "Tab B", url: "https://b.example/" },
+    { page: c, title: "", url: "about:blank" },
+  ];
+
+  test("by title", () => {
+    expect(pickShownPage("Tab B - Chromium", pages)).toBe(b);
+    expect(pickShownPage("Tab A - Chromium", pages)).toBe(a);
+  });
+
+  test("an untitled tab is named by its address", () => {
+    expect(pickShownPage("about:blank - Chromium", pages)).toBe(c);
+  });
+
+  test("no match, or a name that is not Chromium's, tells nothing", () => {
+    expect(pickShownPage("Something else - Chromium", pages)).toBeUndefined();
+    expect(pickShownPage("Tab A", pages)).toBeUndefined();
+  });
+
+  test("two tabs with the same title: the followed one if it is one of them, else no guess", () => {
+    const twins = [
+      { page: a, title: "Inbox", url: "https://a.example/" },
+      { page: b, title: "Inbox", url: "https://b.example/" },
+    ];
+    expect(pickShownPage("Inbox - Chromium", twins, b)).toBe(b);
+    expect(pickShownPage("Inbox - Chromium", twins)).toBeUndefined();
+  });
+});
+
+describe("believing the window name", () => {
+  test("only when two reads agree", async () => {
+    const reads = ["b", "b"];
+    expect(await confirmShown(async () => reads.shift(), 1)).toBe("b");
+    const flip = ["a", "b"];
+    expect(await confirmShown(async () => flip.shift(), 1)).toBeUndefined();
+    let asked = 0;
+    expect(await confirmShown(async () => { asked += 1; return undefined; }, 1)).toBeUndefined();
+    expect(asked).toBe(1);
+  });
+});
