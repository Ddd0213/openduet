+/*
+ * OpenDuet patch (computer/patches/0004): in window mode a person can pick any tab in Chrome's own
+ * tab strip, and the Bot follows the tab in front rather than the newest one.
+ */
+
+/**
+ * The page to follow after pages opened or closed, in window mode: a page that just opened (a
+ * popup, a link opened in a new tab: Chrome puts those in front), else the one followed until now
+ * while it is still open, else the newest open one.
+ */
+export function chooseFollowedPage<T extends OpenPage>(
+  opened: readonly T[],
+  current: T | undefined,
+  justOpened?: T,
+): T | undefined {
+  if (justOpened && !justOpened.isClosed() && opened.includes(justOpened))
+    return justOpened;
+  if (current && !current.isClosed() && opened.includes(current)) return current;
+  return chooseLivePage(opened);
+}
+
+export type TitledPage<T> = { page: T; title: string | null; url: string };
+
+/**
+ * The tab in front, believed only when two reads `gapMs` apart agree. Chromium renames its window a
+ * moment after a page's title changes, so a single read taken while a page navigates can name the
+ * previous title, which another tab may also have.
+ */
+export async function confirmShown<T>(
+  read: () => Promise<T | undefined>,
+  gapMs = 150,
+): Promise<T | undefined> {
+  const first = await read();
+  if (first === undefined) return undefined;
+  await new Promise((resolve) => setTimeout(resolve, gapMs));
+  return (await read()) === first ? first : undefined;
+}
+
+/**
+ * Which page is the tab in front, from the name of Chromium's window ("<tab title> - Chromium").
+ * Undefined when the name matches none of them, or several and none is the one already followed:
+ * a guess would move the Bot to a page nobody chose.
+ */
+export function pickShownPage<T>(
+  windowName: string,
+  pages: readonly TitledPage<T>[],
+  current?: T,
+): T | undefined {
+  const shown = windowName.replace(/ - Chromium$/, "");
+  if (!shown || shown === windowName) return undefined;
+  const matches = pages.filter(({ title, url }) =>
+    title ? title === shown : url === shown || url.replace(/^[a-z]+:\/\//, "").startsWith(shown),
+  );
+  if (matches.some(({ page }) => page === current)) return current;
+  return matches.length === 1 ? matches[0]!.page : undefined;
+}
