--- a/src/screen.ts	1970-01-01 08:00:00
+++ b/src/screen.ts	2026-10-28 00:00:00
@@ -0,0 +1,69 @@
+/**
+ * OpenDuet patch (computer/patches/0001): the virtual screen a headed browser draws on.
+ *
+ * In window mode (headed, on the in-container X server) the live screen is the whole X screen:
+ * Chrome's own tab strip, address bar and pointer, not only the page. The phone watches it upright,
+ * so the default screen is portrait. Chromium will not make a window narrower than 500 DIP
+ * (measured on Chromium 151 under Xvfb: asked for 430, it drew 500 and overflowed the screen), so
+ * the portrait screen is 860x1600 pixels at a device scale factor of 1.72: a 500 CSS px wide page,
+ * near an iPhone's width, at a size the phone can read. `COMPUTER_BROWSER_SCREEN=landscape` gives
+ * the earlier 1280x800 at scale 1.
+ *
+ * The user agent stays desktop Chrome; a narrow window only makes responsive sites lay out narrow.
+ */
+import type { BrowserRuntime } from "./browser-runtime";
+
+export type ScreenLayout = "portrait" | "landscape";
+
+export type ScreenSpec = {
+  layout: ScreenLayout;
+  /** X screen pixels, which is also the size of every live-screen frame in window mode. */
+  width: number;
+  height: number;
+  /** Chromium's --force-device-scale-factor. */
+  scale: number;
+};
+
+const SCREENS: Record<ScreenLayout, ScreenSpec> = {
+  portrait: { layout: "portrait", width: 860, height: 1600, scale: 1.72 },
+  landscape: { layout: "landscape", width: 1280, height: 800, scale: 1 },
+};
+
+export function screenFromEnv(
+  env: Record<string, string | undefined>,
+): ScreenSpec {
+  const raw = env.COMPUTER_BROWSER_SCREEN?.trim() || "portrait";
+  if (raw !== "portrait" && raw !== "landscape") {
+    throw new Error(
+      `COMPUTER_BROWSER_SCREEN must be portrait or landscape, not ${JSON.stringify(raw)}.`,
+    );
+  }
+  return SCREENS[raw];
+}
+
+/** The Xvfb `-screen 0` geometry. */
+export function xvfbGeometry(screen: ScreenSpec): string {
+  return `${screen.width}x${screen.height}x24`;
+}
+
+/**
+ * Whether the live screen and input are the whole window: a managed Chromium drawn on our own X
+ * server. A native Chrome on somebody's desktop and every headless browser keep the page cast.
+ */
+export function isWindowMode(runtime: BrowserRuntime): boolean {
+  return runtime.backend === "managed" && runtime.useVirtualDisplay;
+}
+
+/**
+ * Chromium flags that make its one window fill the X screen. There is no window manager, so the
+ * position and size given are where the window stays. Rounded up (with a little slack for the
+ * float in the scale) so the window reaches the screen's last pixel rather than stopping one short.
+ */
+export function windowArgs(screen: ScreenSpec): string[] {
+  const dip = (pixels: number) => Math.ceil(pixels / screen.scale - 1e-6);
+  return [
+    `--force-device-scale-factor=${screen.scale}`,
+    "--window-position=0,0",
+    `--window-size=${dip(screen.width)},${dip(screen.height)}`,
+  ];
+}
