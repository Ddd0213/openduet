diff -ruN a/tests/screen.test.ts b/tests/screen.test.ts
--- a/tests/screen.test.ts	1970-01-01 08:00:00
+++ b/tests/screen.test.ts	2026-10-28 00:00:00
@@ -0,0 +1,97 @@
+// OpenDuet patch 0001: the virtual screen and the window that fills it.
+import { describe, expect, test } from "bun:test";
+import { browserRuntimeFromEnv } from "../src/browser-runtime";
+import {
+  isWindowMode,
+  screenFromEnv,
+  windowArgs,
+  xvfbGeometry,
+} from "../src/screen";
+import {
+  type DisplayProcess,
+  type DisplayRuntime,
+  startVirtualDisplay,
+} from "../src/virtual-display";
+
+describe("the virtual screen", () => {
+  test("is portrait by default: 860x1600 at scale 1.72, a 500 CSS px page", () => {
+    const screen = screenFromEnv({});
+    expect(screen).toEqual({
+      layout: "portrait",
+      width: 860,
+      height: 1600,
+      scale: 1.72,
+    });
+    expect(xvfbGeometry(screen)).toBe("860x1600x24");
+    // Chromium's narrowest window is 500 DIP; the window must fit the screen exactly.
+    expect(windowArgs(screen)).toEqual([
+      "--force-device-scale-factor=1.72",
+      "--window-position=0,0",
+      "--window-size=500,931",
+    ]);
+  });
+
+  test("landscape is the earlier 1280x800 at scale 1", () => {
+    const screen = screenFromEnv({ COMPUTER_BROWSER_SCREEN: " landscape " });
+    expect(xvfbGeometry(screen)).toBe("1280x800x24");
+    expect(windowArgs(screen)).toContain("--window-size=1280,800");
+  });
+
+  test("refuses anything else", () => {
+    expect(() => screenFromEnv({ COMPUTER_BROWSER_SCREEN: "square" })).toThrow(
+      "COMPUTER_BROWSER_SCREEN must be portrait or landscape",
+    );
+  });
+
+  test("window mode is a managed headed browser on our own X server only", () => {
+    expect(
+      isWindowMode(
+        browserRuntimeFromEnv({ COMPUTER_BROWSER_MODE: "headed" }, "linux"),
+      ),
+    ).toBe(true);
+    expect(
+      isWindowMode(
+        browserRuntimeFromEnv({ COMPUTER_BROWSER_MODE: "headless" }, "linux"),
+      ),
+    ).toBe(false);
+    // A developer's Mac: headed, but no virtual display, so the page cast stays.
+    expect(
+      isWindowMode(
+        browserRuntimeFromEnv({ COMPUTER_BROWSER_MODE: "headed" }, "darwin"),
+      ),
+    ).toBe(false);
+    expect(
+      isWindowMode(
+        browserRuntimeFromEnv(
+          {
+            COMPUTER_BROWSER_BACKEND: "local-chrome",
+            COMPUTER_BROWSER_MODE: "headed",
+          },
+          "linux",
+        ),
+      ),
+    ).toBe(false);
+  });
+
+  test("Xvfb is started at the screen's size", async () => {
+    const spawned: string[][] = [];
+    const process: DisplayProcess = {
+      ready: Promise.resolve(":3"),
+      exited: new Promise(() => {}),
+      kill: () => true,
+    };
+    const runtime: DisplayRuntime = {
+      spawn: (_command, args) => {
+        spawned.push(args);
+        return process;
+      },
+      wait: () => new Promise(() => {}),
+    };
+    await startVirtualDisplay(
+      "headed",
+      runtime,
+      screenFromEnv({ COMPUTER_BROWSER_SCREEN: "portrait" }),
+    );
+    expect(spawned[0]).toContain("860x1600x24");
+  });
+});
