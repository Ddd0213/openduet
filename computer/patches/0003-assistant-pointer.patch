diff -ruN a/tests/assistant-pointer.test.ts b/tests/assistant-pointer.test.ts
--- a/tests/assistant-pointer.test.ts	1970-01-01 08:00:00
+++ b/tests/assistant-pointer.test.ts	2026-10-28 00:00:00
@@ -0,0 +1,49 @@
+// OpenDuet patch 0003: the assistant's pointer glides to the element it is about to click.
+import { describe, expect, test } from "bun:test";
+import { showPointerAt } from "../src/assistant-pointer";
+import { screenFromEnv } from "../src/screen";
+import type { XInput } from "../src/x-input";
+
+const metrics = { screenX: 0, screenY: 0, outerWidth: 500, outerHeight: 932, innerWidth: 500, innerHeight: 845, devicePixelRatio: 1.72 };
+
+function fakes(box: { x: number; y: number; width: number; height: number } | null) {
+  const runs: string[][] = [];
+  const input: XInput = {
+    run: async (commands) => {
+      runs.push(commands);
+      return { x: 10, y: 10 };
+    },
+    windowName: async () => undefined,
+    paste: async () => {},
+    stop: () => {},
+  };
+  const page = { evaluate: async () => metrics } as never;
+  const element = { scrollIntoViewIfNeeded: async () => {}, boundingBox: async () => box } as never;
+  return { runs, input, page, element };
+}
+
+describe("the assistant's pointer", () => {
+  test("glides from where the pointer is to the middle of the element on the X screen", async () => {
+    const f = fakes({ x: 90, y: 20, width: 20, height: 10 });
+    await showPointerAt(f.input, f.page, f.element, screenFromEnv({}));
+    expect(f.runs[0]).toEqual([]);
+    // (100, 25) CSS px -> 172, 150 + 43 = 193
+    expect(f.runs[1]!.at(-1)).toBe("mousemove 172 193");
+  });
+
+  test("does nothing for an element with no box, and never throws", async () => {
+    const f = fakes(null);
+    await showPointerAt(f.input, f.page, f.element, screenFromEnv({}));
+    expect(f.runs).toEqual([]);
+    const broken = { scrollIntoViewIfNeeded: async () => { throw new Error("detached"); } } as never;
+    await showPointerAt(f.input, f.page, broken, screenFromEnv({}));
+  });
+
+  test("is bounded: a page that never answers does not hold the click", async () => {
+    const f = fakes({ x: 0, y: 0, width: 1, height: 1 });
+    const stuck = { scrollIntoViewIfNeeded: () => new Promise(() => {}) } as never;
+    const started = Date.now();
+    await showPointerAt(f.input, f.page, stuck, screenFromEnv({}), 50);
+    expect(Date.now() - started).toBeLessThan(1_000);
+  });
+});
