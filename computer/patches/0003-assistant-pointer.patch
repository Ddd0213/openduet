OpenDuet patch for CopilotKit/OpenBot agent-computer (MIT) at da9a3caf5784074baa779110dd7e9d1338c8871b.
Window mode: before the assistant's click the X pointer glides to the element, so the live screen shows it.
Applied in /app by computer/Dockerfile: patch -p1 --forward --fuzz=0. Regenerated with diff -ruN.

diff -ruN a/src/assistant-pointer.ts b/src/assistant-pointer.ts
--- a/src/assistant-pointer.ts	1970-01-01 08:00:00
+++ b/src/assistant-pointer.ts	2026-10-28 00:00:00
@@ -0,0 +1,42 @@
+/**
+ * OpenDuet patch (computer/patches/0003): the assistant's pointer, visible on the live screen.
+ *
+ * The Bot clicks through Playwright, which goes over CDP and never moves the X pointer, so in window
+ * mode a person watching saw buttons press themselves. Before a click, the X pointer glides to the
+ * middle of the element (the page point plus the content area's place on the X screen) and the
+ * click then lands where it stopped. Best effort and bounded: a pointer that cannot be shown never
+ * holds up or fails the click.
+ */
+import type { Locator, Page } from "playwright";
+import type { ScreenSpec } from "./screen";
+import { pageToScreen, readWindowMetrics, within } from "./window-geometry";
+import { glideCommands, type XInput } from "./x-input";
+
+const POINTER_BUDGET_MS = 1_500;
+
+export async function showPointerAt(
+  input: XInput,
+  page: Page,
+  element: Locator,
+  screen: ScreenSpec,
+  budgetMs = POINTER_BUDGET_MS,
+): Promise<void> {
+  await within(
+    (async () => {
+      // Playwright scrolls into view before it clicks; doing it first means the box is where the
+      // click will be.
+      await element.scrollIntoViewIfNeeded({ timeout: 1_000 });
+      const box = await element.boundingBox({ timeout: 500 });
+      if (!box) return;
+      const metrics = await readWindowMetrics(page, 300);
+      if (!metrics) return;
+      const to = pageToScreen(metrics, {
+        x: box.x + box.width / 2,
+        y: box.y + box.height / 2,
+      });
+      const from = (await input.run([])) ?? to;
+      await input.run(glideCommands(from, to, screen));
+    })(),
+    budgetMs,
+  );
+}
