+    expect(pageToScreen(metrics, { x: 100, y: 10 })).toEqual({ x: 172, y: 167 });
+  });
+});
+
+function fakeCapture() {
+  const spawned: string[][] = [];
+  const children: Array<ChildProcess & { stdout: PassThrough; killedWith: string[] }> = [];
+  const spawnCapture = (args: string[]) => {
+    spawned.push(args);
+    const child = Object.assign(new EventEmitter(), {
+      stdout: new PassThrough(),
+      stderr: new PassThrough(),
+      exitCode: null as number | null,
+      signalCode: null as string | null,
+      killedWith: [] as string[],
+      kill(signal: string) {
+        child.killedWith.push(signal);
+        child.signalCode = signal;
+        queueMicrotask(() => child.emit("exit", null, signal));
+        return true;
+      },
+    });
+    children.push(child as never);
+    return child as unknown as ChildProcess;
+  };
+  return { spawned, children, spawnCapture };
+}
+
+const noInput: XInput = {
