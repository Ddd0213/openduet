+/** A JPEG-shaped byte string: a DQT holding FF D9, stuffed FF 00 and a restart marker in the scan. */
+function fakeJpeg(tag: number): Uint8Array {
+  return Uint8Array.from([
+    0xff, 0xd8, // SOI
+    0xff, 0xe0, 0x00, 0x04, 0x4a, 0x46, // APP0, length 4
+    0xff, 0xdb, 0x00, 0x05, 0xff, 0xd9, tag, // DQT whose table bytes include FF D9
+    0xff, 0xda, 0x00, 0x03, 0x01, // SOS, length 3
+    0x12, 0xff, 0x00, 0x34, 0xff, 0xd0, 0x56, tag, // scan: stuffed FF, RST0
+    0xff, 0xd9, // EOI
+  ]);
+}
+
+describe("cutting Motion-JPEG into frames", () => {
+  test("a frame ends at the EOI after its scan, not at FF D9 inside a header", () => {
+    const jpeg = fakeJpeg(7);
+    expect(jpegEnd(jpeg, 0)).toBe(jpeg.length);
+    expect(jpegEnd(jpeg.slice(0, 14), 0)).toBe(-1);
+  });
+
+  test("frames split across chunks at every byte come out whole and in order", () => {
+    const stream = new Uint8Array([...fakeJpeg(1), ...fakeJpeg(2), ...fakeJpeg(3)]);
+    for (let cut = 1; cut < stream.length; cut += 1) {
+      const splitter = new JpegSplitter();
+      const frames = [...splitter.push(stream.slice(0, cut)), ...splitter.push(stream.slice(cut))];
+      expect(frames.map((f) => f.at(-3))).toEqual([1, 2, 3]);
+    }
+  });
+
+  test("garbage before a frame is skipped", () => {
+    const splitter = new JpegSplitter();
+    const frames = splitter.push(new Uint8Array([0x00, 0xff, 0x12, ...fakeJpeg(9)]));
+    expect(frames).toHaveLength(1);
+    expect(frames[0]![0]).toBe(0xff);
+  });
+
+  test("an unchanged frame is a repeat; a changed one is not", () => {
+    const dedup = new FrameDedup();
+    expect(dedup.isRepeat(fakeJpeg(1))).toBe(false);
+    expect(dedup.isRepeat(fakeJpeg(1))).toBe(true);
+    expect(dedup.isRepeat(fakeJpeg(2))).toBe(false);
+  });
+});
+
+const SCREEN = screenFromEnv({});
+
+describe("a person's input as xdotool commands", () => {
+  test("a press moves, then presses, and says where it landed", () => {
+    expect(
+      planInput({ type: "mouse", event: "pressed", x: 120.4, y: 33.6, button: "left" }, SCREEN),
+    ).toEqual({ kind: "x", commands: ["mousemove 120 34", "mousedown 1"], pressedAt: { x: 120, y: 34 } });
+    expect(planInput({ type: "mouse", event: "released", x: 5, y: 5, button: "right" }, SCREEN)).toEqual({
+      kind: "x",
+      commands: ["mousemove 5 5", "mouseup 3"],
+    });
+  });
+
+  test("coordinates are clamped to the screen", () => {
+    const plan = planInput({ type: "mouse", event: "moved", x: -40, y: 99999 }, SCREEN);
+    expect(plan).toEqual({ kind: "x", commands: ["mousemove 0 1599"] });
+  });
+
+  test("the wheel becomes whole clicks, carrying the remainder", () => {
+    const carry = { x: 0, y: 0 };
+    expect(planInput({ type: "wheel", x: 430, y: 800, deltaX: 0, deltaY: 300 }, SCREEN, carry)).toEqual({
+      kind: "x",
+      commands: ["mousemove 430 800", "click --repeat 2 --delay 8 5"],
+    });
+    expect(carry.y).toBe(60);
+    expect(planInput({ type: "wheel", x: 430, y: 800, deltaX: 0, deltaY: 60 }, SCREEN, carry)).toEqual({
+      kind: "x",
+      commands: ["mousemove 430 800", "click --repeat 1 --delay 8 5"],
+    });
+    expect(planInput({ type: "wheel", x: 0, y: 0, deltaX: -120, deltaY: 0 }, SCREEN, carry)).toEqual({
+      kind: "x",
+      commands: ["mousemove 0 0", "click --repeat 1 --delay 8 6"],
+    });
+  });
+
+  test("keys go by keysym; nothing a person sends reaches xdotool as text", () => {
+    expect(keysymFor("Enter")).toBe("Return");
+    expect(keysymFor("Backspace")).toBe("BackSpace");
+    expect(keysymFor("a")).toBe("a");
+    expect(keysymFor(".")).toBe("period");
+    expect(keysymFor("exec")).toBeUndefined();
+    expect(keysymFor("a b")).toBeUndefined();
+    expect(planInput({ type: "key", event: "down", key: "Enter", code: "Enter" }, SCREEN)).toEqual({
+      kind: "x",
+      commands: ["keydown Return"],
+    });
+    expect(planInput({ type: "key", event: "up", key: "ArrowLeft", code: "ArrowLeft" }, SCREEN)).toEqual({
+      kind: "x",
+      commands: ["keyup Left"],
