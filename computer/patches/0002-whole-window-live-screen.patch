+    // A key with no keysym of ours that carries a character is typed as text.
+    expect(planInput({ type: "key", event: "down", key: "é", code: "KeyE", text: "é" }, SCREEN)).toEqual({
+      kind: "text",
+      text: "é",
+    });
+    expect(planInput({ type: "key", event: "down", key: "\nexec sh", code: "" }, SCREEN)).toEqual({ kind: "none" });
+    expect(planInput({ type: "text", text: "你好 world" }, SCREEN)).toEqual({ kind: "text", text: "你好 world" });
+  });
+
+  test("a glide ends on the target and stays on the screen", () => {
+    const commands = glideCommands({ x: 0, y: 0 }, { x: 400, y: 900 }, SCREEN, 4, 30);
+    expect(commands.at(-1)).toBe("mousemove 400 900");
+    expect(commands.filter((c) => c.startsWith("sleep"))).toEqual(["sleep 0.030", "sleep 0.030", "sleep 0.030"]);
+  });
+
+  test("a paste after a tap on the address bar selects what is there first", () => {
+    expect(pasteCommands()).toEqual(["key --clearmodifiers ctrl+v"]);
+    expect(pasteCommands(true)).toEqual(["key --clearmodifiers ctrl+a", "key --clearmodifiers ctrl+v"]);
+  });
+
+  test("xdotool's answers", () => {
+    expect(parseMouseLocation("x:12 y:34 screen:0 window:56")).toEqual({ x: 12, y: 34 });
+    expect(parseMouseLocation("Tab A - Chromium")).toBeUndefined();
+    expect(parseWindowName(["Tab A - Chromium", "x:1 y:2 screen:0 window:3"])).toBe("Tab A - Chromium");
+    expect(parseWindowName(["x:1 y:2 screen:0 window:3"])).toBeUndefined();
+  });
+});
+
+describe("where the page sits on the X screen", () => {
+  // Measured: portrait screen, Chromium 151, tab strip + toolbar = 87 DIP.
+  const metrics = { screenX: 0, screenY: 0, outerWidth: 500, outerHeight: 932, innerWidth: 500, innerHeight: 845, devicePixelRatio: 1.72 };
+
+  test("the content begins below the browser's own UI", () => {
+    expect(contentOrigin(metrics)).toEqual({ x: 0, y: 150 });
