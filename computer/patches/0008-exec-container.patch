+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { existsSync } from "node:fs";
+import { mkdir, mkdtemp, realpath, rm, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { type ExecServer, startExecServer } from "../src/exec-server";
+import {
+  CommandRunnerUnreachableError,
+  createRemoteShell,
+} from "../src/remote-shell";
+
+/**
+ * OpenDuet patch 0008: the shell in a container of its own, reached over a unix socket.
+ *
+ * These run the real server on a real socket and real commands, so what is checked is what the
+ * computer's `/exec` gets back: the command ran in the Bot's folder without the computer's secrets,
+ * its timeout and a Stop still end it (and what it started), and a runner that is not there is an
+ * error rather than a command run somewhere else.
+ */
+
+let root: string;
+let socketPath: string;
+let server: ExecServer | undefined;
+
+const SECRET_ENV = {
+  PATH: process.env.PATH,
+  COMPUTER_TOKEN: "computer-token-must-not-pass",
+  HOME: "/root",
+};
+
+async function start(separate = true): Promise<ExecServer> {
+  server = await startExecServer({
+    socketPath,
+    workspaceRoot: join(root, "workspace"),
+    separate,
+    sourceEnv: SECRET_ENV,
+  });
+  return server;
+}
+
+function post(path: string, body: unknown, signal?: AbortSignal) {
+  return fetch(`http://localhost${path}`, {
+    unix: socketPath,
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+    ...(signal ? { signal } : {}),
+  });
+}
+
+beforeEach(async () => {
+  root = await mkdtemp(join(tmpdir(), "exec-server-"));
+  // A directory the server has to create, as the compose volume's mountpoint is in a fresh container.
+  socketPath = join(root, "sock", "exec.sock");
+});
+
+afterEach(async () => {
+  await server?.stop();
+  server = undefined;
+  await rm(root, { recursive: true, force: true });
+});
+
+describe("a command through the runner", () => {
+  test("runs in its Bot's folder, with HOME there and no secret from the runner's environment", async () => {
+    await start();
+    const result = await createRemoteShell(socketPath, "sales").run({
+      command: 'pwd; echo "$HOME"; env; exit 3',
+    });
+    const folder = await realpath(join(root, "workspace", "computers", "sales"));
+    const [cwd, home] = result.stdout.split("\n");
+    expect(result.exitCode).toBe(3);
+    expect(result.timedOut).toBe(false);
+    expect(cwd).toBe(folder);
+    expect(await realpath(home ?? "")).toBe(folder);
+    expect(result.stdout).not.toContain("computer-token-must-not-pass");
+    expect(result.stdout).not.toContain("COMPUTER_TOKEN");
+  });
+
+  test("a computer serving one Bot keeps commands at the workspace root", async () => {
+    await start(false);
+    const result = await createRemoteShell(socketPath, "duet").run({
+      command: "pwd",
+    });
+    expect(result.stdout.trim()).toBe(await realpath(join(root, "workspace")));
+  });
+
+  test("its own timeout ends it, and what it started", async () => {
+    await start(false);
+    const started = Date.now();
+    const result = await createRemoteShell(socketPath, "duet").run({
+      command: "sleep 4 | cat; touch late-marker",
+      timeoutMs: 1_000,
+    });
+    expect(result.timedOut).toBe(true);
+    expect(Date.now() - started).toBeLessThan(3_500);
+    await Bun.sleep(4_000);
+    expect(existsSync(join(root, "workspace", "late-marker"))).toBe(false);
+  }, 15_000);
+
+  test("a command longer than Bun's 10 second idle limit still gets its answer", async () => {
+    // 15 s: past the point (about 12 s, measured) where Bun cuts an idle request that has no body.
+    // `/exec` is a POST with one, which Bun 1.3.6 and 1.4.3 did not cut either way; this holds the
+    // runner to that whatever Bun's default becomes.
+    await start(false);
+    const result = await createRemoteShell(socketPath, "duet").run({
+      command: "sleep 15; echo finished",
+      timeoutMs: 30_000,
+    });
+    expect(result.timedOut).toBe(false);
+    expect(result.exitCode).toBe(0);
+    expect(result.stdout.trim()).toBe("finished");
+  }, 30_000);
+});
