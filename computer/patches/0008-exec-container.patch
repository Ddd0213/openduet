diff -ruN a/src/remote-shell.ts b/src/remote-shell.ts
--- a/src/remote-shell.ts	1970-01-01 08:00:00
+++ b/src/remote-shell.ts	2026-10-28 00:00:00
@@ -0,0 +1,158 @@
+/**
+ * OpenDuet patch 0008: the computer's end of the command runner (exec-server.ts).
+ *
+ * The same `run` as shell.ts, so `/exec` keeps its shape: the wheel is checked before this is
+ * called and held until it returns, the timeout is the command's own, and a Stop ends the command.
+ *
+ * NEVER A FALLBACK. If the runner cannot be reached the command fails and says so. Running it in
+ * this process instead would put it back beside the browser profiles and this process's token,
+ * which is the thing the separate container exists to prevent, and nobody would notice.
+ */
+import { randomUUID } from "node:crypto";
+import type { ShellResult } from "./shell";
+
+/** shell.ts's bounds, mirrored to size the wait below; the runner applies the real ones. */
+const DEFAULT_TIMEOUT_MS = 120_000;
+const MIN_TIMEOUT_MS = 1_000;
+const MAX_TIMEOUT_MS = 600_000;
+
+/**
+ * How long past the command's own timeout the runner has to answer. A command that times out is
+ * killed and answered at once, so this only ever ends a runner that has stopped answering.
+ */
+const ANSWER_GRACE_MS = 30_000;
+
+/** How long a Stop waits for the runner to say the command has ended. */
+const CANCEL_WAIT_MS = 10_000;
+
+/**
+ * Bun names the failure in `code` (ENOENT, ECONNREFUSED); its message, "Was there a typo in the
+ * url or port?", points the reader at the wrong thing for a unix socket.
+ */
+function unreachableBecause(cause: unknown, socketPath: string): string {
+  const code = (cause as { code?: unknown } | null)?.code;
+  if (code === "ENOENT") return `ENOENT: there is no socket at ${socketPath}`;
+  if (code === "ECONNREFUSED") {
+    return `ECONNREFUSED: nothing is listening on ${socketPath}`;
+  }
+  if (typeof code === "string" && code) return `${code} on ${socketPath}`;
+  return cause instanceof Error ? cause.message : String(cause);
+}
+
+export class CommandRunnerUnreachableError extends Error {
+  constructor(cause: unknown, socketPath: string) {
+    super(
+      `The command runner is not reachable, so the command did not run (${unreachableBecause(cause, socketPath)}). Commands run in the computer-exec container; check that it is running.`,
+    );
+    this.name = "CommandRunnerUnreachableError";
+  }
+}
+
+function waitFor(timeoutMs: number | undefined): number {
+  const requested =
+    typeof timeoutMs === "number" && Number.isFinite(timeoutMs)
+      ? timeoutMs
+      : DEFAULT_TIMEOUT_MS;
+  return (
+    Math.min(Math.max(requested, MIN_TIMEOUT_MS), MAX_TIMEOUT_MS) +
+    ANSWER_GRACE_MS
+  );
+}
+
+/**
+ * A Stop by name, waited on until the runner says the command is gone (or CANCEL_WAIT_MS passes),
+ * so the wheel is released after the command ends, as it was when the command ran in this process.
+ */
+async function cancel(
+  socketPath: string,
+  runId: string,
+): Promise<ShellResult | null> {
+  try {
+    const response = await fetch("http://localhost/cancel", {
+      unix: socketPath,
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ runId }),
+      signal: AbortSignal.timeout(CANCEL_WAIT_MS),
+    });
+    const answer = (await response.json().catch(() => null)) as {
+      result?: ShellResult | null;
+    } | null;
+    return answer?.result ?? null;
+  } catch {
+    return null;
+  }
+}
+
+export function createRemoteShell(socketPath: string, botId: string) {
+  return {
+    async run(input: {
+      command: string;
+      timeoutMs?: number;
+      signal?: AbortSignal;
+    }): Promise<ShellResult> {
+      const runId = randomUUID();
+      const controller = new AbortController();
+      let silent = false;
+      const guard = setTimeout(() => {
+        silent = true;
+        controller.abort();
+      }, waitFor(input.timeoutMs));
+      const onStop = () => controller.abort();
+      input.signal?.addEventListener("abort", onStop, { once: true });
+      // As in shell.ts: a Stop that landed before this line is honoured too.
+      if (input.signal?.aborted) controller.abort();
+
+      // Dropping the request already reaches the command; this waits until it has ended.
+      const stopped = async (): Promise<ShellResult> => {
+        const ended = await cancel(socketPath, runId);
+        if (silent) {
+          throw new Error(
+            "The command runner did not answer in time, so the command was stopped.",
+          );
+        }
+        if (ended) return ended;
+        throw new Error("The command was stopped.");
+      };
+
+      try {
+        let response: Response;
+        try {
+          response = await fetch("http://localhost/exec", {
+            unix: socketPath,
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({
+              botId,
+              command: input.command,
+              ...(input.timeoutMs !== undefined
+                ? { timeoutMs: input.timeoutMs }
+                : {}),
+              runId,
+            }),
+            signal: controller.signal,
+          });
+        } catch (error) {
+          if (controller.signal.aborted) return await stopped();
+          throw new CommandRunnerUnreachableError(error, socketPath);
+        }
+        const answer = (await response.json().catch(() => null)) as
+          | (ShellResult & { error?: undefined })
+          | { error?: unknown }
+          | null;
+        if (answer === null && controller.signal.aborted) return await stopped();
+        if (!response.ok || !answer || typeof answer.error === "string") {
+          // The runner answered and refused; its words are the error.
+          throw new Error(
+            (answer && typeof answer.error === "string" && answer.error) ||
+              `The command runner answered ${response.status}.`,
+          );
+        }
+        return answer as ShellResult;
+      } finally {
+        clearTimeout(guard);
+        input.signal?.removeEventListener("abort", onStop);
+      }
+    },
+  };
+}
