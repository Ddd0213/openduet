+describe("the socket", () => {
+  test("only its owner may connect, in a directory only its owner may enter", async () => {
+    await start();
+    expect((await stat(socketPath)).mode & 0o777).toBe(0o600);
+    expect((await stat(join(root, "sock"))).mode & 0o777).toBe(0o700);
+  });
+
+  test("a socket left by a runner that was killed is replaced", async () => {
+    await mkdir(join(root, "sock"), { recursive: true });
+    const orphan = Bun.spawn(
+      [
+        process.execPath,
+        "-e",
+        "require('node:net').createServer().listen(process.env.SOCK); setInterval(() => {}, 1000);",
+      ],
+      { env: { ...process.env, SOCK: socketPath } },
+    );
+    for (let i = 0; i < 50 && !existsSync(socketPath); i++) await Bun.sleep(100);
+    orphan.kill("SIGKILL");
+    await orphan.exited;
+    expect(existsSync(socketPath)).toBe(true);
+
+    await start(false);
+    const result = await createRemoteShell(socketPath, "duet").run({
+      command: "echo again",
+    });
+    expect(result.stdout.trim()).toBe("again");
+  }, 15_000);
+
+  test("a file that is not a socket is left alone and the runner does not start", async () => {
+    await mkdir(join(root, "sock"), { recursive: true });
+    await writeFile(socketPath, "keep me");
+    await expect(start()).rejects.toThrow("is not a socket");
+    server = undefined;
+    expect(await Bun.file(socketPath).text()).toBe("keep me");
+  });
+
+  test("a second runner does not take the place of one that answers", async () => {
+    const first = await start(false);
+    await expect(
+      startExecServer({
+        socketPath,
+        workspaceRoot: join(root, "workspace"),
+        separate: false,
+      }),
+    ).rejects.toThrow("already answering");
+    server = first;
+    const result = await createRemoteShell(socketPath, "duet").run({
+      command: "echo still-first",
+    });
+    expect(result.stdout.trim()).toBe("still-first");
+  });
+
+  test("stopping the runner ends its commands and removes the socket", async () => {
+    const running = await start(false);
+    const pending = post("/exec", {
+      botId: "duet",
+      command: "sleep 30; touch shutdown-marker",
+    }).catch(() => null);
+    await Bun.sleep(300);
+    const started = Date.now();
+    await running.stop();
+    server = undefined;
+    await pending;
+    expect(Date.now() - started).toBeLessThan(6_000);
+    expect(existsSync(socketPath)).toBe(false);
+    expect(existsSync(join(root, "workspace", "shutdown-marker"))).toBe(false);
+  }, 15_000);
+});
+
+describe("a runner that is not there", () => {
+  test("is an error that says so, and nothing runs", async () => {
+    const shell = createRemoteShell(join(root, "absent", "exec.sock"), "duet");
+    const error = await shell.run({ command: "touch absent-marker" }).catch((e) => e);
