+/**
+ * OpenDuet patch 0008: the computer's shell in a container of its own.
+ *
+ * WHY. A command run in the computer's container can reach everything that container holds: the
+ * browser profiles in /profiles (cookies and saved sign-ins), the computer's own process and its
+ * environment (`/proc/<pid>/environ` carries COMPUTER_TOKEN), and in headed mode the X display the
+ * person watches. The gateway's policy decides whether a command may run, but once one runs it is
+ * the container that decides what it can reach (shell.ts says the same). So the shell moves out.
+ *
+ * WHAT THIS IS. `shell.ts` behind a unix socket, run with `bun src/exec-server.ts` in a container
+ * that mounts only /workspace and the socket's directory. The computer's `/exec` forwards here when
+ * COMPUTER_EXEC_SOCKET is set (remote-shell.ts); it still checks the token and the wheel first.
+ *
+ * NO TOKEN HERE. Nothing but a unix socket listens, the socket is mode 600 and its directory is
+ * shared only between this container and the computer, both running as the same uid. A token would
+ * be one more secret in a container whose whole point is to hold none.
+ *
+ * The same folder rules as the file tools (workspaces.ts), so `COMPUTER_SEPARATE_WORKSPACES` must be
+ * set the same way here and on the computer.
+ */
+import { chmod, lstat, mkdir, rm, unlink, writeFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { isPlainBotId } from "./bot-id";
+import { startEgressFilter } from "./egress";
+import { parseExecTimeout } from "./request-validation";
+import type { ShellResult } from "./shell";
+import { createWorkspaces } from "./workspaces";
+
+/** A run id names one command, so a Stop can find it. A uuid fits; nothing longer is needed. */
+const RUN_ID = /^[A-Za-z0-9_-]{1,64}$/;
+
+/**
+ * Bigger than any command can be. Linux refuses a single argument over 128 KiB (MAX_ARG_STRLEN),
+ * and the command reaches bash as one, so a body past this could never have run anyway.
+ */
+const MAX_BODY_BYTES = 1024 * 1024;
+
+/** How long a Stop for a command that has not arrived yet is remembered. */
+const CANCEL_MEMORY_MS = 60_000;
+const CANCEL_MEMORY_MAX = 1_000;
+
+export type ExecServerOptions = {
+  /** The unix socket to listen on. Its directory is created mode 700 if missing. */
+  socketPath: string;
+  /** The workspace root, the same folder the computer's file tools use. */
+  workspaceRoot: string;
+  /** COMPUTER_SEPARATE_WORKSPACES=on: one folder per Bot under `computers/`. */
+  separate: boolean;
+  /** What a command's environment is built from (shell.ts passes an allow-list of it). */
+  sourceEnv?: NodeJS.ProcessEnv;
+};
+
+export type ExecServer = {
+  socketPath: string;
+  stop: () => Promise<void>;
+};
+
+type Running = {
+  controller: AbortController;
+  done: Promise<ShellResult | null>;
+};
+
+function json(body: unknown, status = 200): Response {
+  return Response.json(body, { status });
+}
+
+function describe(error: unknown, fallback: string): string {
+  return error instanceof Error ? error.message : fallback;
+}
+
+async function readBody(request: Request): Promise<unknown> {
+  const declared = Number(request.headers.get("content-length") ?? "0");
+  if (Number.isFinite(declared) && declared > MAX_BODY_BYTES) return null;
+  const text = await request.text().catch(() => "");
+  if (Buffer.byteLength(text, "utf8") > MAX_BODY_BYTES) return null;
+  try {
+    return JSON.parse(text);
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Whatever is at the socket's path from an earlier run.
+ *
+ * A container killed without a clean stop leaves its socket file behind, and listening on a path
+ * that exists fails. That file is removed, but only once it is known to be a socket nobody answers:
+ * a regular file or a directory there is not ours to delete, and a server that still answers means
+ * a second copy of this container, which should not quietly take the first one's place.
+ */
+async function clearStaleSocket(socketPath: string): Promise<void> {
+  const existing = await lstat(socketPath).catch((error: NodeJS.ErrnoException) => {
+    if (error.code === "ENOENT") return null;
+    throw error;
+  });
+  if (!existing) return;
+  if (!existing.isSocket()) {
+    throw new Error(
+      `${socketPath} exists and is not a socket, so the command runner will not replace it.`,
+    );
+  }
+  const answered = await fetch("http://localhost/health", {
+    unix: socketPath,
+    signal: AbortSignal.timeout(1_000),
+  })
+    .then(() => true)
+    .catch(() => false);
+  if (answered) {
+    throw new Error(
+      `Another command runner is already answering on ${socketPath}.`,
+    );
+  }
+  await unlink(socketPath).catch((error: NodeJS.ErrnoException) => {
+    if (error.code !== "ENOENT") throw error;
+  });
+}
+
+export async function startExecServer(
+  options: ExecServerOptions,
+): Promise<ExecServer> {
+  const { socketPath } = options;
+  const workspaces = createWorkspaces(
+    options.workspaceRoot,
+    options.separate,
+    options.sourceEnv ?? process.env,
+  );
+  const running = new Map<string, Running>();
+  const anonymous = new Set<Running>();
+  const cancelled = new Map<string, number>();
+
+  const rememberCancel = (runId: string) => {
+    const now = Date.now();
+    for (const [id, at] of cancelled) {
+      if (now - at <= CANCEL_MEMORY_MS && cancelled.size < CANCEL_MEMORY_MAX)
+        break;
+      cancelled.delete(id);
+    }
+    cancelled.set(runId, now);
+  };
+
+  await mkdir(dirname(socketPath), { recursive: true, mode: 0o700 });
+  await clearStaleSocket(socketPath);
+
+  const server = Bun.serve({
+    unix: socketPath,
+    /*
+     * No idle limit. Bun's default is 10 seconds, and a command sends nothing until it ends, so an
+     * install could come back as a dropped connection. The command's own timeout is the limit
+     * (shell.ts).
+     *
+     * Measured on Bun 1.3.6 and 1.4.3 over a unix socket: a request without a body is cut at about
+     * 12 seconds unless this is 0 (`server.timeout(request, 0)` does not help), and a POST with a
+     * body, which is what `/exec` is, was not cut. Set anyway, so the answer does not depend on
+     * that. bun-types declares the option for a TCP server only, hence the spread.
+     */
+    ...({ idleTimeout: 0 } as object),
+    maxRequestBodySize: MAX_BODY_BYTES,
+    async fetch(request) {
+      const url = new URL(request.url);
+
+      if (url.pathname === "/health" && request.method === "GET") {
+        return json({ ok: true, running: running.size + anonymous.size });
+      }
+
+      if (url.pathname === "/exec" && request.method === "POST") {
+        const body = (await readBody(request)) as {
+          botId?: unknown;
+          command?: unknown;
+          timeoutMs?: unknown;
+          runId?: unknown;
+        } | null;
+        if (typeof body?.botId !== "string" || !isPlainBotId(body.botId)) {
+          return json({ error: "That is not a usable bot id." }, 400);
+        }
+        if (typeof body.command !== "string" || !body.command.trim()) {
+          return json({ error: "A command is required." }, 400);
+        }
+        const timeout = parseExecTimeout(body.timeoutMs);
+        if (!timeout.ok) return json({ error: timeout.error }, 400);
+        let runId: string | undefined;
+        if (body.runId !== undefined) {
+          if (typeof body.runId !== "string" || !RUN_ID.test(body.runId)) {
+            return json({ error: "That is not a usable run id." }, 400);
+          }
+          runId = body.runId;
+          if (running.has(runId)) {
+            return json({ error: "That run id is already running." }, 409);
+          }
+          // The Stop beat the command here: it never starts.
+          if (cancelled.delete(runId)) {
+            return json({ error: "The command was stopped before it started." }, 409);
+          }
+        }
+
+        // Stopped by the caller going away (the computer aborts its request on Stop) or by /cancel.
+        const controller = new AbortController();
+        const onGone = () => controller.abort();
+        request.signal.addEventListener("abort", onGone, { once: true });
+        if (request.signal.aborted) controller.abort();
+
+        let settle: (result: ShellResult | null) => void = () => undefined;
+        const entry: Running = {
+          controller,
+          done: new Promise((resolve) => {
+            settle = resolve;
+          }),
+        };
+        if (runId) running.set(runId, entry);
+        else anonymous.add(entry);
+        try {
+          const { shell } = await workspaces.for(body.botId);
+          const result = await shell.run({
+            command: body.command,
+            ...(timeout.timeoutMs !== undefined
+              ? { timeoutMs: timeout.timeoutMs }
+              : {}),
+            signal: controller.signal,
+          });
+          settle(result);
+          return json(result);
+        } catch (error) {
+          settle(null);
+          return json(
+            { error: describe(error, "The command could not be run.") },
+            500,
+          );
+        } finally {
+          request.signal.removeEventListener("abort", onGone);
+          if (runId) running.delete(runId);
+          else anonymous.delete(entry);
+        }
+      }
+
+      /*
+       * A Stop by name, answered once the command has ended.
+       *
+       * The computer also drops its request, which reaches the command through `request.signal`.
+       * This is the second way in, and the one the computer waits on: it answers after the process
+       * group is gone, so the computer lets go of the wheel no earlier than it did when the command
+       * ran in its own process.
+       */
+      if (url.pathname === "/cancel" && request.method === "POST") {
+        const body = (await readBody(request)) as { runId?: unknown } | null;
+        if (typeof body?.runId !== "string" || !RUN_ID.test(body.runId)) {
+          return json({ error: "That is not a usable run id." }, 400);
+        }
+        const entry = running.get(body.runId);
+        if (!entry) {
+          rememberCancel(body.runId);
+          return json({ stopped: false });
+        }
+        entry.controller.abort();
+        const result = await entry.done;
+        return json({ stopped: true, result });
+      }
+
+      return json({ error: "Not found." }, 404);
+    },
+  });
+
+  // Only this uid may connect. The directory is 700 as well; this holds if it was made by someone else.
+  await chmod(socketPath, 0o600);
+
+  let stopping: Promise<void> | null = null;
+  const stop = () => {
+    stopping ??= (async () => {
+      const all = [...running.values(), ...anonymous];
+      for (const entry of all) entry.controller.abort();
+      await Promise.race([
+        Promise.all(all.map((entry) => entry.done)),
+        Bun.sleep(5_000),
+      ]);
+      await server.stop(true);
+      await rm(socketPath, { force: true });
+    })();
+    return stopping;
+  };
+
+  return { socketPath, stop };
+}
+
+/** The same check the computer makes before it says it is ready (index.ts `assertWritable`). */
+async function assertWritable(directory: string): Promise<void> {
+  const probe = join(directory, `.openbot-write-probe-${process.pid}`);
+  try {
+    await mkdir(directory, { recursive: true });
+    await writeFile(probe, "");
+    await rm(probe, { force: true });
+  } catch (error) {
+    console.error(
+      `The workspace at ${directory} is not writable by uid ${process.getuid?.() ?? "unknown"}: ${String(error)}. ` +
+        "Commands run there and write there, so the command runner refuses to start instead.",
+    );
+    process.exit(1);
+  }
+}
+
+if (import.meta.main) {
+  const socketPath = process.env.COMPUTER_EXEC_SOCKET?.trim();
+  if (!socketPath) {
+    console.error(
+      "COMPUTER_EXEC_SOCKET is not set: the command runner needs the unix socket the computer forwards to.",
+    );
+    process.exit(1);
+  }
+  const workspaceRoot = process.env.WORKSPACE_DIR?.trim() || "/workspace";
+  const separate =
+    process.env.COMPUTER_SEPARATE_WORKSPACES?.trim().toLowerCase() === "on";
+  await assertWritable(workspaceRoot);
+  // Commands go through the same policy filter, chained to the same upstream proxy, as they did in
+  // the computer's container. Started before the socket exists, so no command runs without it.
+  await startEgressFilter({ forShell: true });
+  let server: ExecServer;
+  try {
+    server = await startExecServer({ socketPath, workspaceRoot, separate });
+  } catch (error) {
+    console.error(describe(error, "The command runner could not start."));
+    process.exit(1);
+  }
+  console.info(
+    JSON.stringify({
+      type: "computer-exec-listening",
+      socket: socketPath,
+      workspace: workspaceRoot,
+      separateWorkspaces: separate,
+      uid: process.getuid?.() ?? null,
+    }),
+  );
+  for (const signal of ["SIGTERM", "SIGINT"] as const) {
+    process.on(signal, () => {
+      void server.stop().then(() => process.exit(0));
+    });
+  }
+}
