+describe("a Stop", () => {
+  test("mid-command ends it, settles once it has ended, and it never writes", async () => {
+    await start(false);
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), 300);
+    const started = Date.now();
+    const outcome = await createRemoteShell(socketPath, "duet")
+      .run({
+        command: "sleep 3; touch stopped-marker",
+        timeoutMs: 20_000,
+        signal: controller.signal,
+      })
+      .then(
+        (result) => ({ result }),
+        (error: Error) => ({ error }),
+      );
+    clearTimeout(timer);
+    expect(Date.now() - started).toBeLessThan(2_500);
+    if ("result" in outcome) expect(outcome.result.timedOut).toBe(false);
+    else expect(outcome.error.message).toContain("stopped");
+    // Nothing is still running on the runner once the Stop has settled.
+    const health = (await (
+      await fetch("http://localhost/health", { unix: socketPath })
+    ).json()) as { running: number };
+    expect(health.running).toBe(0);
+    await Bun.sleep(3_500);
+    expect(existsSync(join(root, "workspace", "stopped-marker"))).toBe(false);
+  }, 15_000);
+
+  test("that landed before the call never starts the command", async () => {
+    await start(false);
+    await expect(
+      createRemoteShell(socketPath, "duet").run({
+        command: "touch early-marker",
+        signal: AbortSignal.abort(),
+      }),
+    ).rejects.toThrow("stopped");
+    await Bun.sleep(500);
+    expect(existsSync(join(root, "workspace", "early-marker"))).toBe(false);
+  });
+
+  test("by run id ends a command whose request is still open", async () => {
+    await start(false);
+    const running = post("/exec", {
+      botId: "duet",
+      command: "sleep 3; touch named-marker",
+      runId: "run-1",
+    });
+    await Bun.sleep(300);
+    const cancelled = (await (await post("/cancel", { runId: "run-1" })).json()) as {
+      stopped: boolean;
+      result: { timedOut: boolean; exitCode: number } | null;
+    };
+    expect(cancelled.stopped).toBe(true);
+    expect(cancelled.result?.timedOut).toBe(false);
+    expect(cancelled.result?.exitCode).not.toBe(0);
+    const answer = (await (await running).json()) as { exitCode: number };
+    expect(answer.exitCode).not.toBe(0);
+    await Bun.sleep(3_500);
+    expect(existsSync(join(root, "workspace", "named-marker"))).toBe(false);
+  }, 15_000);
+
+  test("by run id that arrives before the command is remembered, and the command is refused", async () => {
+    await start(false);
+    const cancelled = (await (await post("/cancel", { runId: "run-2" })).json()) as {
+      stopped: boolean;
+    };
+    expect(cancelled.stopped).toBe(false);
+    const answer = await post("/exec", {
+      botId: "duet",
+      command: "touch refused-marker",
+      runId: "run-2",
+    });
+    expect(answer.status).toBe(409);
+    await Bun.sleep(300);
+    expect(existsSync(join(root, "workspace", "refused-marker"))).toBe(false);
+  });
+});
+
+describe("what the runner refuses", () => {
+  test.each([
+    ["a bot id that is a path", { botId: "../etc", command: "touch bad-marker" }],
+    ["no bot id", { command: "touch bad-marker" }],
+    ["a blank command", { botId: "duet", command: "   " }],
+    ["a timeout below the shell's floor", { botId: "duet", command: "touch bad-marker", timeoutMs: 5 }],
+    ["a timeout that is not a number", { botId: "duet", command: "touch bad-marker", timeoutMs: "60000" }],
+    ["a run id with a separator", { botId: "duet", command: "touch bad-marker", runId: "a/b" }],
+  ])("%s, with a 400 and nothing run", async (_name, body) => {
+    await start(true);
+    const answer = await post("/exec", body);
+    expect(answer.status).toBe(400);
+    expect(existsSync(join(root, "workspace", "bad-marker"))).toBe(false);
+    expect(existsSync(join(root, "workspace", "computers"))).toBe(false);
+  });
+
+  test("a body that is not JSON, and an unknown path", async () => {
+    await start(false);
+    const garbled = await fetch("http://localhost/exec", {
+      unix: socketPath,
+      method: "POST",
+      body: "not json",
+    });
+    expect(garbled.status).toBe(400);
+    const unknown = await fetch("http://localhost/files/read", { unix: socketPath });
+    expect(unknown.status).toBe(404);
+  });
+
+  test("the runner's refusal reaches the computer as its own words", async () => {
+    await start(true);
+    await expect(
+      createRemoteShell(socketPath, "../etc").run({ command: "true" }),
+    ).rejects.toThrow("That is not a usable bot id.");
+  });
+});
