+/** OpenDuet patch 0006: a tab put in front, for the Bot and, in window mode, in Chrome's window. */
+async function putInFront(botId: string, page: Page): Promise<boolean> {
+  if (!profiles.pick(botId, page)) return false;
+  await within(page.bringToFront(), 1_000);
+  return true;
+}
+
