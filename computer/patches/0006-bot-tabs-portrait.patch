+const ERROR_PAGE_MS = 1_000;
+
+/**
+ * OpenDuet patch 0006: a person sends a tab somewhere. Answered once the new document commits,
+ * not when it has loaded: the live screen shows the rest. A load that fails or takes longer is not
+ * an error to them, because the screen shows Chromium's own page for it or the page arriving; it
+ * is logged. Only web addresses (the request is checked with `/navigate`'s own rule), and through
+ * the egress filter as every request of this browser.
+ */
+async function humanGoto(target: Page, address: string): Promise<void> {
+  try {
+    await target.goto(address, { waitUntil: "commit", timeout: HUMAN_NAVIGATION_MS });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    // Chromium commits its error page a moment after the load failed; the tab strip asks next.
+    if (/net::ERR_/.test(message) && !/net::ERR_ABORTED/.test(message)) {
+      const deadline = Date.now() + ERROR_PAGE_MS;
