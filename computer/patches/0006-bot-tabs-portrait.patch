+ *   OPENBOT_COMPUTER_BROWSER=1 bun test tests/bot-tabs-browser.test.ts
+ *   OPENBOT_COMPUTER_BROWSER=1 TABS_TEST_SCREEN=portrait bun test tests/bot-tabs-browser.test.ts
