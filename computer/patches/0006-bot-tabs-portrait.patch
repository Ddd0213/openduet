+/*
+ * OpenDuet patch 0006: the Bot's tabs, for the app's own tab strip and address bar.
+ *
+ * Headless, the live screen is only the page, so the phone draws the browser's bar itself and
+ * needs to know what is open: each tab's id, address and title, which one the Bot follows, and
+ * whether there is anywhere to go back or forward to. The tab id is the page's DevTools target id,
+ * which stays the same for the life of the tab. Adapted from CopilotKit/OpenBot's agent-computer
+ * 0.2.0 (src/browser-host.ts `tabIdOf`, `tabsOf`, `shownUrl`, and the hosted browser keeping one
+ * tab open; MIT).
+ *
+ * In its own file, without importing Playwright's runtime, so its tests need no browser.
+ */
+import type { CDPSession, Page } from "playwright";
+import { parseNavigateUrl } from "./request-validation";
+import { within } from "./window-geometry";
+
+export type BotTab = { id: string; url: string; title: string; active: boolean };
+
+export type BotTabs = {
+  tabs: BotTab[];
+  /** The followed tab's history, so the app greys out ← and →. */
+  canGoBack: boolean;
+  canGoForward: boolean;
+};
+
+export const NO_TABS: BotTabs = { tabs: [], canGoBack: false, canGoForward: false };
+
+/** Chromium's own page for an address that did not load. */
+export const ERROR_PAGE = "chrome-error://";
+
+/** How long one tab may take to say what it shows before the answer leaves it out. */
+const ASK_MS = 300;
+
+/** The part of a page this needs, so tests can hand in a stand-in. */
+export type TabPage = Pick<Page, "url" | "isClosed"> & {
+  context(): { newCDPSession(page: Page): Promise<Pick<CDPSession, "send">> };
+};
+
+/*
+ * One DevTools session per page, opened at the first question and kept for the life of the page:
+ * the app's strip is checked every second while somebody watches, and opening and detaching a
+ * session each time would be most of the work. The session only reads (target info, history); it
+ * enables no domain, so nothing a page can observe changes.
+ */
+const sessions = new WeakMap<object, Promise<Pick<CDPSession, "send">>>();
+const ids = new WeakMap<object, string>();
+
+async function ask<T>(page: TabPage, method: string): Promise<T | undefined> {
+  let session = sessions.get(page);
+  if (!session) {
+    session = page.context().newCDPSession(page as unknown as Page);
+    sessions.set(page, session);
+  }
+  try {
+    return (await (await session).send(method as never)) as T;
+  } catch {
+    // A session that broke (the page closed, the browser went) is opened again next time.
+    sessions.delete(page);
+    return undefined;
+  }
+}
+
+type TargetInfo = { targetInfo: { targetId: string; url: string; title: string } };
+type History = { currentIndex: number; entries: unknown[] };
+
+/** The address a tab shows: its page's, or on Chromium's error page the address that failed. */
+export function shownUrl(pageUrl: string, targetUrl: string | undefined): string {
+  return pageUrl.startsWith(ERROR_PAGE) && targetUrl ? targetUrl : pageUrl;
+}
+
+/** The open tabs in the browser's order, and the followed one's history. */
+export async function listTabs(pages: readonly TabPage[], active: TabPage): Promise<BotTabs> {
+  const open = pages.filter((page) => !page.isClosed());
+  const infos = await Promise.all(
+    open.map((page) => within(ask<TargetInfo>(page, "Target.getTargetInfo"), ASK_MS)),
+  );
+  const tabs: BotTab[] = [];
+  open.forEach((page, index) => {
+    const info = infos[index]?.targetInfo;
+    if (!info) return;
+    ids.set(page, info.targetId);
+    tabs.push({
+      id: info.targetId,
+      url: shownUrl(page.url(), info.url),
+      title: info.title,
+      active: page === active,
+    });
+  });
+  const history = open.includes(active)
+    ? await within(ask<History>(active, "Page.getNavigationHistory"), ASK_MS)
+    : undefined;
+  const at = history?.currentIndex ?? 0;
+  return {
+    tabs,
+    canGoBack: history ? at > 0 : false,
+    canGoForward: history ? at < history.entries.length - 1 : false,
+  };
+}
+
+/** The open page with this tab id, asking the pages not yet asked. */
+export async function pageWithId<T extends TabPage>(
+  pages: readonly T[],
+  id: string,
+): Promise<T | undefined> {
+  for (const page of pages) {
+    if (page.isClosed()) continue;
+    let known = ids.get(page);
+    if (!known) {
+      known = (await within(ask<TargetInfo>(page, "Target.getTargetInfo"), ASK_MS))?.targetInfo
+        .targetId;
+      if (known) ids.set(page, known);
+    }
+    if (known === id) return page;
+  }
+  return undefined;
+}
+
+/**
+ * The tab to follow when the followed one closes, as a browser does it: the one to its right, else
+ * the one to its left. Undefined when it is not the followed one or is the only tab.
+ */
+export function neighbourOf<T>(pages: readonly T[], closing: T, active: T): T | undefined {
+  if (closing !== active) return undefined;
+  const at = pages.indexOf(closing);
+  if (at < 0) return undefined;
+  return pages[at + 1] ?? pages[at - 1];
+}
+
+/** A tab state as one comparable string, so a push goes out only when something changed. */
+export function fingerprint(state: BotTabs): string {
+  return JSON.stringify(state);
+}
+
+/* ------------------------------------ what a person asks for ------------------------------------ */
+
+/**
+ * `POST /human/tabs`. Addresses arrive already resolved (the server turns what was typed into an
+ * http(s) address or a search); this only checks they are web addresses. `close` may name the page
+ * to open first when it is the last tab, so the screen always has one.
+ */
+export type TabAction =
+  | { action: "new"; url?: string }
+  | { action: "activate"; tabId: string }
+  | { action: "close"; tabId: string; replaceWith?: string };
+
+/** `POST /human/navigate`: the followed tab goes to an address, or back, forward or reloads. */
+export type NavigateAction = { url: string } | { action: "back" | "forward" | "reload" };
+
+type Parsed<T> = { ok: true; value: T } | { ok: false; error: string };
+
+const MAX_ADDRESS = 2000;
+const MAX_TAB_ID = 200;
+
+function address(value: unknown): Parsed<string> {
+  if (typeof value === "string" && value.trim().length > MAX_ADDRESS)
+    return { ok: false, error: "That address is too long." };
+  const parsed = parseNavigateUrl(value);
+  return parsed.ok ? { ok: true, value: parsed.url } : { ok: false, error: parsed.error };
+}
+
+function tabId(value: unknown): Parsed<string> {
+  return typeof value === "string" && value.trim() && value.length <= MAX_TAB_ID
+    ? { ok: true, value: value.trim() }
+    : { ok: false, error: "A tabId is required." };
+}
+
+export function parseTabAction(body: unknown): Parsed<TabAction> {
+  const input = (body && typeof body === "object" ? body : {}) as Record<string, unknown>;
+  if (input.action === "new") {
+    if (input.url === undefined) return { ok: true, value: { action: "new" } };
+    const url = address(input.url);
+    return url.ok ? { ok: true, value: { action: "new", url: url.value } } : url;
+  }
+  if (input.action === "activate" || input.action === "close") {
+    const id = tabId(input.tabId);
+    if (!id.ok) return id;
+    if (input.action === "activate")
+      return { ok: true, value: { action: "activate", tabId: id.value } };
+    if (input.replaceWith === undefined)
+      return { ok: true, value: { action: "close", tabId: id.value } };
+    const url = address(input.replaceWith);
+    return url.ok
+      ? { ok: true, value: { action: "close", tabId: id.value, replaceWith: url.value } }
+      : url;
+  }
+  return { ok: false, error: "action must be new, activate or close." };
+}
+
+export function parseNavigateAction(body: unknown): Parsed<NavigateAction> {
+  const input = (body && typeof body === "object" ? body : {}) as Record<string, unknown>;
+  if (input.url !== undefined) {
+    const url = address(input.url);
+    return url.ok ? { ok: true, value: { url: url.value } } : url;
+  }
+  if (input.action === "back" || input.action === "forward" || input.action === "reload")
+    return { ok: true, value: { action: input.action } };
+  return { ok: false, error: "Send a url, or an action: back, forward or reload." };
+}
+
+/* ------------------------------------- telling the screen ------------------------------------- */
+
+/*
+ * The live screen of each Bot registers here while it is open, so a tab action answered over HTTP
+ * reaches the socket at once instead of at the next second of the follow loop.
+ */
+const watchers = new Map<string, () => void>();
+
+/** Register the screen's check for this Bot; the returned function unregisters that one only. */
+export function watchTabs(botId: string, check: () => void): () => void {
+  watchers.set(botId, check);
+  return () => {
+    if (watchers.get(botId) === check) watchers.delete(botId);
+  };
+}
+
+/** Something about this Bot's tabs changed; its screen, if one is open, looks now. */
+export function tabsChanged(botId: string): void {
+  watchers.get(botId)?.();
+}
+
+/**
+ * One run at a time of `work`, and one more after it however often it was asked meanwhile: the
+ * follow loop's second and a tab action can ask together, and two casts must not start on one page.
+ */
+export function oneAtATime(work: () => Promise<void>): () => Promise<void> {
+  let running: Promise<void> | undefined;
+  let again = false;
+  const run = (): Promise<void> => {
+    if (running) {
+      again = true;
+      return running;
+    }
+    running = (async () => {
+      try {
+        do {
+          again = false;
+          await work().catch(() => undefined);
+        } while (again);
+      } finally {
+        running = undefined;
+      }
+    })();
+    return running;
+  };
+  return run;
+}
