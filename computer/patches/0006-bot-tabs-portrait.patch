+// OpenDuet patch 0006: the Bot's tabs for the app's own tab strip and address bar.
+import { describe, expect, test } from "bun:test";
+import {
+  fingerprint,
+  listTabs,
+  neighbourOf,
+  oneAtATime,
+  pageWithId,
+  parseNavigateAction,
+  parseTabAction,
+  shownUrl,
+  type TabPage,
+  tabsChanged,
+  watchTabs,
+} from "../src/bot-tabs";
+
+type Fake = TabPage & { asked: string[] };
+
+/** A page whose DevTools session answers like Chromium's, counting the sessions opened. */
+function fakePage(
+  id: string,
+  url: string,
+  title: string,
+  options: { history?: [number, number]; closed?: boolean; silent?: boolean } = {},
+  opened = { count: 0 },
+): Fake {
+  const asked: string[] = [];
+  const page: Fake = {
+    asked,
+    url: () => url,
+    isClosed: () => options.closed ?? false,
+    context: () => ({
+      newCDPSession: async () => {
+        opened.count += 1;
+        return {
+          send: (async (method: string) => {
+            asked.push(method);
+            if (options.silent) return new Promise(() => {});
+            if (method === "Target.getTargetInfo")
+              return {
+                targetInfo: {
+                  targetId: id,
+                  url: url.startsWith("chrome-error://") ? "https://failed.example/" : url,
+                  title,
+                },
+              };
+            const [currentIndex, length] = options.history ?? [0, 1];
+            return { currentIndex, entries: Array.from({ length }) };
+          }) as never,
+        };
+      },
+    }),
+  };
+  return page;
+}
+
+describe("listing the tabs", () => {
+  test("in the browser's order, with the followed one active and its history", async () => {
+    const a = fakePage("A", "https://a.example/", "A");
+    const b = fakePage("B", "https://b.example/", "B", { history: [1, 3] });
+    expect(await listTabs([a, b], b)).toEqual({
+      tabs: [
+        { id: "A", url: "https://a.example/", title: "A", active: false },
+        { id: "B", url: "https://b.example/", title: "B", active: true },
+      ],
+      canGoBack: true,
+      canGoForward: true,
+    });
+    // Only the followed tab's history is asked.
+    expect(a.asked).toEqual(["Target.getTargetInfo"]);
+  });
+
+  test("at either end of the history, the arrow that has nowhere to go is off", async () => {
+    const first = fakePage("A", "https://a.example/", "A", { history: [0, 2] });
+    expect(await listTabs([first], first)).toMatchObject({ canGoBack: false, canGoForward: true });
