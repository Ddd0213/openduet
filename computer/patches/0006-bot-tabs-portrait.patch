+ * closes while the Bot follows it hands over to its neighbour, as a browser does; the last tab
+ * opens `replaceWith` first (the server sends its start page), so the screen always has a page.
+ */
+async function humanTabAction(botId: string, action: TabAction): Promise<boolean> {
+  await currentPage(botId, "navigate");
+  if (action.action === "new") {
+    const opened = await profiles.openTab(botId);
+    await within(opened.bringToFront(), 1_000);
+    if (action.url) await humanGoto(opened, action.url);
+    return true;
+  }
