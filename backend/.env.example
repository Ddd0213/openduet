# OpenDuet backend configuration.
# `bun run dev` reads this file as backend/.env; docker compose loads it for every service.
# scripts/setup.sh writes it for you (chmod 600). Never commit backend/.env.
# [required] = the backend refuses to start without it. [optional] = feature is off when empty.

# ---------------------------------------------------------------- server
# [required] Public address the app types in, e.g. https://duet.example.com or http://192.168.1.10:3000
PUBLIC_URL=http://localhost:3000
# [optional] Port the backend listens on inside its container / on the host (default 3000)
PORT=3000
# [optional] LAN mode only: host address compose publishes PORT on (default 127.0.0.1)
BIND_ADDR=127.0.0.1
# [optional] Name shown in the app before sign-in (default "OpenDuet")
SERVER_NAME=OpenDuet
# [required] SQLite database (WAL). Relative paths are resolved from backend/prisma/.
DATABASE_URL=file:../data/duet.db
# [optional] Directory for channel files, screenshots and uploads (default ./data/files)
FILES_DIR=./data/files
# [optional] Comma-separated exact reverse-proxy IPs or Docker service names (caddy / tunnel).
# Names resolve via Docker DNS, exact addresses only, cached 30 s; resolution failure trusts none.
# Legacy CIDRs remain accepted, but never use a bridge subnet on a VPS. Empty = trust none.
TRUSTED_PROXIES=
# [optional] debug | info | warn | error (default info). Logs are JSON with secrets redacted.
LOG_LEVEL=info
# [optional] 198.18.0.0/15: auto detects fake-IP answers for fixed public probes; 1 allows, 0 denies.
# Defaults to auto even if absent. Backend rechecks every 5 min; egress checks on startup.
ALLOW_FAKE_IP_RANGE=auto

# ---------------------------------------------------------------- auth
# [required] Random secret, at least 32 characters: openssl rand -base64 48
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------- models
# Either list gateways in backend/models.json (see models.example.json) or use the one-gateway shortcut below.
# [optional] Path to the models file (default ./models.json)
MODELS_FILE=./models.json
# [optional] One-gateway shortcut, used when models.json is absent: anthropic | openai
LLM_PROTOCOL=
# [optional] Gateway base URL, e.g. https://api.anthropic.com or https://api.openai.com/v1
LLM_BASE_URL=
# [optional] Gateway API key (shortcut mode). With models.json, each provider names its own key variable.
LLM_API_KEY=
# [optional] Model id exactly as the gateway names it (shortcut mode)
LLM_MODEL=
# [optional] Shortcut mode, anthropic protocol: x-api-key (default) | bearer (Authorization: Bearer)
LLM_AUTH_HEADER=
# [optional] Shortcut mode: what LLM_MODEL supports, comma-separated from tools,vision,thinking,serverWebTools,promptCaching (default tools)
LLM_CAPABILITIES=
# [required unless LLM_MODEL is set] Model id or comma-separated fallback chain for chats
MODEL_CHAT=
# [optional] Background tasks and Make builds (default MODEL_CHAT)
MODEL_TASK=
# [optional] Morning brief, check-ins and the first-day scan (default MODEL_CHAT)
MODEL_PROACTIVE=
# [optional] Titles, summaries, classification (default MODEL_CHAT)
MODEL_UTILITY=
# [optional] Keys named by apiKeyEnv in models.example.json; set the ones your models.json uses.
# Local Ollama ignores the key, but apiKeyEnv must still name a nonempty variable (any dummy value).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
# [optional] Per-request idle timeout in seconds: the longest wait for the first response
# byte or between streamed chunks. Long outputs that keep streaming are never cut (default 120)
LLM_TIMEOUT_SECONDS=120
# [optional] Exact hosts allowed to use plain http besides localhost (e.g. LAN Ollama).
# These hosts also bypass model private-address checks. Only add hosts you control.
LLM_ALLOW_INSECURE_HOSTS=
# [optional] Exact private HTTPS model gateway hosts/IPs; does not allow plain HTTP.
LLM_ALLOW_PRIVATE_HOSTS=
# [optional] Token limits per 5-hour session and per 7 days (input + output tokens of every run);
# 0 = no limit, the default: nothing is ever blocked and no "Usage limit reached" line is posted.
# Set e.g. 3000000 and 30000000 to turn them on.
SESSION_TOKEN_LIMIT=0
WEEKLY_TOKEN_LIMIT=0

# ---------------------------------------------------------------- proactive
# [optional] 1 = run the built-in morning brief and the 5 daily check-ins (GET /api/schedule then
# says builtins: true). Default 0: off. The user's own scheduled tasks (routines) and the one-time
# first-day scan run either way.
PROACTIVE_BUILTINS=0

# ---------------------------------------------------------------- Composio (connectors)
# [optional] https://app.composio.dev API key; without it connectors show "isn't set up yet"
COMPOSIO_API_KEY=

# ---------------------------------------------------------------- web search
# [optional] tavily | brave | serper | searxng | exa | parallel. Empty (M25) = the key-less default:
# Exa's free MCP search, then Parallel's when Exa fails or is busy (the search words go to them, US
# companies). exa / parallel = only that one, no key. Turn the key-less default off with
# BUILTIN_CONNECTORS_OFF=web_search (then web_search isn't offered unless a provider is set here).
SEARCH_PROVIDER=
# [optional] Key for tavily / brave / serper
SEARCH_API_KEY=
# [optional] Base URL of your SearXNG instance (searxng only)
SEARXNG_URL=

# ---------------------------------------------------------------- built-in connectors (M25)
# Key-less read-only tools every user has: web_search (the key-less default above), weather
# (Open-Meteo), exchange_rate (Frankfurter, ECB data), read_feed (RSS / Atom, read from the feed's
# own site). [optional] Comma-separated ids to turn off on this server, e.g. weather,read_feed
BUILTIN_CONNECTORS_OFF=
# [optional] Open-Meteo's free API is for non-commercial use only (a personal self-hosted server is
# fine; data CC BY 4.0, "Weather data by Open-Meteo.com"). A commercial deployment needs its paid
# plan: set the key and its hosts (customer-api.open-meteo.com / customer-geocoding-api.open-meteo.com),
# or point these at your own Open-Meteo. Empty = the free API.
OPEN_METEO_URL=
OPEN_METEO_GEOCODING_URL=
OPEN_METEO_API_KEY=

# ---------------------------------------------------------------- push
# [optional] apns | ntfy | bark; empty = notifications are local only
NOTIFY_PROVIDER=
# [optional] APNs token auth: key id, team id and the .p8 key. APNS_KEY takes the key contents
# (newlines may be written as \n) or a file path; in Docker paste the contents, since the
# backend container has no bind mounts.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
# [not supported] APNs certificate auth (.p12): Bun's TLS ignores client certificates, so setting
# APNS_CERT stops the backend with a config error. Use a .p8 key (Apple Developer > Keys).
APNS_CERT=
APNS_CERT_PASSWORD=
# [optional] The app's final bundle id
APNS_TOPIC=
# [optional] production | sandbox: only a fallback. Each device registers with its own environment
# (Xcode debug builds are sandbox), and pushes go to that one.
APNS_ENV=production
# [optional] ntfy server, topic and access token (the push carries only a title and a deep link)
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# [optional] Bark server and device key; with NOTIFY_PROVIDER=bark, BARK_ENCRYPTION_KEY (16/24/32
# chars) and BARK_ENCRYPTION_IV (16 chars) are required (pushes are always encrypted).
# Test any provider with: bun run notify:test --username <u>
BARK_URL=
BARK_DEVICE_KEY=
BARK_ENCRYPTION_KEY=
BARK_ENCRYPTION_IV=

# ---------------------------------------------------------------- OpenDuet's computer
# [optional] Computer API base URL (compose: http://computer:4100; compose.dev.yml: http://127.0.0.1:4100)
COMPUTER_URL=
# [optional, required with COMPUTER_URL] Random token, 24+ characters: openssl rand -hex 24
COMPUTER_TOKEN=
# [optional] Bot id the computer reports as (default duet)
COMPUTER_BOT_ID=duet
# [optional] Username whose computer it is (the browser, its logins and /workspace are one person's).
# Other accounts on this server get no computer. Default: the first account created.
COMPUTER_OWNER=
# [optional] Proxy every outbound request of the computer goes through (compose: http://egress:3128)
EGRESS_PROXY_DEFAULT=
# [optional] How OpenDuet's browser runs: headless (default) or headed (a real Chrome window on a
# virtual display; the live screen then shows the whole window with its tab strip and address
# bar; uses more memory, and in our tests Cloudflare challenged it far more often). setup.sh --browser.
COMPUTER_BROWSER_MODE=
# [optional] landscape (default) or portrait. Headless: the page, 1280x800 or 430x660 CSS px at
# scale 2. Headed: the virtual screen, 1280x800 or 860x1600. setup.sh --browser-screen.
COMPUTER_BROWSER_SCREEN=
# [optional] The browser closes after this many ms without use and wakes on the next action; the
# container and OpenDuet's logins stay. Default 1800000 (30 min); 0 = never. setup.sh --browser-idle.
COMPUTER_BROWSER_IDLE_MS=
# [optional] The page the browser shows when it wakes with nothing open (http/https).
# Default https://www.bing.com/ (reachable worldwide, picks the local market itself).
COMPUTER_START_URL=

# ---------------------------------------------------------------- vault (M11)
# [optional] Key for the secrets the server keeps (custom connector keys, keys typed into
# connection cards): base64 of 32 bytes, e.g. openssl rand -base64 32. Empty: the server makes
# /data/db/vault.key on first use (scripts/backup.sh backs it up). Set it to keep the key apart from
# the database; changing or losing it makes the stored secrets unreadable.
# On a new VPS set this before storing secrets; encrypt backups/dotenv and store off-server.
# Never substitute a newly generated key for an existing vault key.
VAULT_KEY=

# ---------------------------------------------------------------- deployment (compose profiles)
# [optional] Cloudflare Tunnel token for the "tunnel" profile
TUNNEL_TOKEN=
# [optional] Access mode chosen by scripts/setup.sh: lan | tailscale | caddy | tunnel
DUET_MODE=
# [optional] Read by docker compose from ./.env (setup.sh links it to this file). lan/tailscale:
# compose.yml:compose.lan.yml (the backend publishes BIND_ADDR:PORT); caddy/tunnel: compose.yml
COMPOSE_FILE=
# [optional] Compose profiles to start: caddy (domain + HTTPS) or tunnel (Cloudflare Tunnel); empty otherwise
COMPOSE_PROFILES=
# [optional] Prebuilt images: e.g. ghcr.io/<owner>/openduet (images <prefix>-backend, -computer, -egress, -caddy)
# and the release version, then `docker compose pull`. Defaults build locally as openduet-*:local.
DUET_IMAGE_PREFIX=
DUET_VERSION=
# [optional] compose.dev.yml only: loopback port the computer is relayed to for `bun run dev` (default 4100)
COMPUTER_DEV_PORT=
