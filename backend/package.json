{
  "name": "openduet-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.6"
  },
  "scripts": {
    "dev": "bun --env-file=.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "user:create": "bun --env-file=.env src/cli/user-create.ts",
    "user:password": "bun --env-file=.env src/cli/user-password.ts",
    "user:delete": "bun --env-file=.env src/cli/user-delete.ts",
    "models:check": "bun --env-file=.env src/cli/models-check.ts",
    "health": "bun --env-file=.env src/cli/health.ts",
    "notify:test": "bun --env-file=.env src/cli/notify-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@composio/core": "0.27.0",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.12",
    "file-type": "22.2.0",
    "hono": "4.13.14",
    "html-to-text": "10.0.1",
    "mammoth": "1.13.0",
    "openai": "7.43.0",
    "undici": "7.30.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "@types/html-to-text": "9.0.4",
    "prisma": "6.19.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8"
  }
}
